{
    "name": "oaa-frontend",
    "version": "0.4.0",
    "private": true,
    "bugs": {
        "url": "https://github.com/suse-edu-cn/oaa-frontend/issues"
    },
    "license": "GPL-3.0",
    "author": {
        "name": "crrashh1542",
        "email": "1542@crrashh.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/suse-edu-cn/oaa-frontend"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:public": "vite --mode development-public",
        "build": "vite build",
        "build:internal": "vite build --mode internal",
        "preview": "vite preview",
        "lint": "oxlint && eslint",
        "lint:fix": "oxlint --fix && eslint --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "type-check": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.vitest.json",
        "format": "oxfmt --check",
        "format:write": "oxfmt",
        "prepare": "husky"
    },
    "dependencies": {
        "@primeuix/themes": "^3.0.1",
        "@primevue/forms": "^5.0.2",
        "axios": "^1.20.0",
        "cropperjs": "^1.7.0",
        "highlight.js": "^11.12.0",
        "js-cookie": "^3.0.8",
        "katex": "^0.19.0",
        "less": "^4.9.1",
        "md-editor-v3": "^7.1.0",
        "modern-normalize": "^3.0.1",
        "nprogress": "^0.2.0",
        "pinia": "^4.0.3",
        "primevue": "^4.5.5",
        "screenfull": "^6.0.2",
        "vite": "^8.3.4",
        "vue": "^3.5.43",
        "vue-router": "^5.4.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^26.6.5",
        "@types/nprogress": "^0.2.3",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "5.0.5",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/server-renderer": "3.5.43",
        "@vue/test-utils": "2.5.1",
        "eslint": "^10.12.0",
        "eslint-plugin-vue": "~10.11.1",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jsdom": "30.1.3",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.87.0",
        "typescript": "^6.0.3",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "lint-staged": {
        "*.{js,ts,css,less,vue}": "oxfmt"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ]
}
