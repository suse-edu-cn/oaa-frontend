{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "trailingComma": "es5",
    "singleQuote": true,
    "jsxSingleQuote": true,
    "tabWidth": 4,
    "semi": false,
    "singleAttributePerLine": false,
    "printWidth": 120,
    "ignorePatterns": [".claude/*", ".github/*", ".vscode/*", "scripts/*", "*.md", "index.html"]
}
